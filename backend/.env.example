# Neon Postgres 연결 문자열 (프로젝트별 별도 DB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 액세스 토큰 서명 키 — 운영 배포 시 반드시 임의의 긴 값으로 교체
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# 사용자가 직접 발급해 채움 (https://platform.openai.com)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 크롤링 타임아웃(ms)
CRAWL_TIMEOUT_MS=8000

PORT=3000

# 프론트 오리진 (CORS 허용, Vercel URL)
CORS_ORIGIN="http://localhost:5173"
